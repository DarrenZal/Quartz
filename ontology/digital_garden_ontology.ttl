@prefix : <http://darrenzal.net/kg/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Base IRI for your knowledge graph entities (articles/concepts)
@prefix base: <http://darrenzal.net/kg/resource/> .

# --- Classes ---

:DigitalGardenArticle rdf:type rdfs:Class ;
    rdfs:label "Digital Garden Article" ;
    rdfs:comment "A generic article or note within the digital garden." .

:Concept rdf:type rdfs:Class ;
    rdfs:subClassOf :DigitalGardenArticle ;
    rdfs:label "Concept" ;
    rdfs:comment "An abstract idea, theory, or notion." .

:Principle rdf:type rdfs:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "Principle" ;
    rdfs:comment "A fundamental truth or proposition that serves as the foundation for a system of belief or behavior or for a chain of reasoning." .

:Technology rdf:type rdfs:Class ;
    rdfs:subClassOf :DigitalGardenArticle ;
    rdfs:label "Technology" ;
    rdfs:comment "A tool, technique, system, organization or method." .

:Theme rdf:type rdfs:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "Theme" ;
    rdfs:comment "A main subject or idea that is being discussed or described." .

:PlaceBasedConcept rdf:type rdfs:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "Place-Based Concept" ;
    rdfs:comment "A concept related to specific geographical or ecological regions." .

# --- Discourse Graph Classes (Research Structure) ---

:Claim rdf:type rdfs:Class ;
    rdfs:label "Claim" ;
    rdfs:comment "An assertion or statement put forward for consideration or debate in research discourse." .

:Evidence rdf:type rdfs:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "Data, studies, observations, or empirical support that validates or refutes claims." .

:Question rdf:type rdfs:Class ;
    rdfs:label "Question" ;
    rdfs:comment "An inquiry, research question, or problem raised for investigation." .

:Source rdf:type rdfs:Class ;
    rdfs:label "Source" ;
    rdfs:comment "Original research, papers, reports, or materials that substantiate evidence." .

:Problem rdf:type rdfs:Class ;
    rdfs:label "Problem" ;
    rdfs:comment "A challenge, issue, or difficulty identified in research or practice." .

:Solution rdf:type rdfs:Class ;
    rdfs:label "Solution" ;
    rdfs:comment "A proposed method, technology, or approach to address identified problems." .

:Method rdf:type rdfs:Class ;
    rdfs:label "Method" ;
    rdfs:comment "A systematic procedure, technique, or process for accomplishing research or practical goals." .

:Finding rdf:type rdfs:Class ;
    rdfs:label "Finding" ;
    rdfs:comment "A result, outcome, or discovery from research, analysis, or implementation." .

:Recommendation rdf:type rdfs:Class ;
    rdfs:label "Recommendation" ;
    rdfs:comment "A suggested course of action, policy, or intervention based on analysis and evidence." .

# --- Object Properties (linking resources to resources) ---

:mentions rdf:type rdf:Property ;
    rdfs:label "mentions" ;
    rdfs:comment "The subject document mentions the object concept/document. This can be a default for wiki-links." .

:exploresConcept rdf:type rdf:Property ;
    rdfs:label "explores concept" ;
    rdfs:comment "The subject document explores the object concept in detail." ;
    rdfs:domain :DigitalGardenArticle ;
    rdfs:range :Concept .

:relatedTo rdf:type rdf:Property ;
    rdfs:label "related to" ;
    rdfs:comment "A general associative relationship between two concepts or articles." ;
    skos:relatedMatch schema:relatedLink .

:isa rdf:type rdf:Property ;
    rdfs:label "is a" ;
    rdfs:comment "States that the subject is an instance of the object class." .

:usesTechnology rdf:type rdf:Property ;
    rdfs:label "uses technology" ;
    rdfs:comment "The subject makes use of the object technology." .

:leverages rdf:type rdf:Property ;
    rdfs:label "leverages" ;
    rdfs:comment "The subject utilizes or takes advantage of the object." .

:inspiredBy rdf:type rdf:Property ;
    rdfs:label "inspired by" ;
    rdfs:comment "The subject draws inspiration from the object." .

# --- Discourse Graph Properties ---

:supports rdf:type rdf:Property ;
    rdfs:label "supports" ;
    rdfs:comment "Evidence supports a claim, or a claim supports another claim." .

:opposes rdf:type rdf:Property ;
    rdfs:label "opposes" ;
    rdfs:comment "Evidence opposes a claim, or a claim opposes another claim." .

:substantiates rdf:type rdf:Property ;
    rdfs:label "substantiates" ;
    rdfs:comment "A source provides evidence for evidence nodes." .

:informs rdf:type rdf:Property ;
    rdfs:label "informs" ;
    rdfs:comment "Evidence or claims inform or generate new questions." .

:generates rdf:type rdf:Property ;
    rdfs:label "generates" ;
    rdfs:comment "Questions, claims, or research generate new elements." .

:addresses rdf:type rdf:Property ;
    rdfs:label "addresses" ;
    rdfs:comment "A solution, method, or claim addresses a specific problem or question." .

:implements rdf:type rdf:Property ;
    rdfs:label "implements" ;
    rdfs:comment "A method or technology implements a proposed solution." .

:validates rdf:type rdf:Property ;
    rdfs:label "validates" ;
    rdfs:comment "Evidence or findings validate a claim, method, or solution." .

:refutes rdf:type rdf:Property ;
    rdfs:label "refutes" ;
    rdfs:comment "Evidence or findings refute or contradict a claim." .

# --- Data Properties (linking resources to literals) ---

:hasAlias rdf:type rdf:Property ;
    rdfs:label "has alias" ;
    rdfs:comment "An alternative name or synonym for the subject." ;
    rdfs:range rdfs:Literal .

:hasSummary rdf:type rdf:Property ;
    rdfs:label "has summary" ;
    rdfs:comment "A brief summary of the subject." ;
    rdfs:range rdfs:Literal .